# PostgreSQL bağlantısı — üretimde Neon connection string kullanın
DATABASE_URL="postgresql://kullanici@localhost:5432/finoptima?schema=public"

# openssl rand -base64 32 ile üretin
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Anthropic (Claude) API anahtarı — kredi koçu AI özelliği için.
# console.anthropic.com'dan alınır. Lokal .env + Vercel project env'ine eklenir.
ANTHROPIC_API_KEY=""

# Demo modu: "true" → AI çağrılmaz, kullanıcının kendi verisinden türetilen
# gerçekçi örnek sonuç döner (anahtarsız 0$ test / sunumda yedek plan).
# Gerçek kullanımda boş bırak / kaldır.
AI_DEMO=""

# ---------------------------------------------------------------------------
# AI sağlayıcı seçimi — aynı ürün, iki farklı kapı. Kod değişmez, sadece bu env.
#   (boş) | "anthropic" → doğrudan Anthropic API (varsayılan)
#   "foundry"           → Microsoft Foundry üzerinden Claude
# ---------------------------------------------------------------------------
AI_PROVIDER=""

# Foundry kaynak adı (protokolsüz host). AI_PROVIDER=foundry iken ZORUNLU.
# Örn: "finoptima.services.ai.azure.com"
AZURE_FOUNDRY_RESOURCE=""

# Alternatif: tam taban URL (resource yerine ya da onu ezmek için).
# Örn: "https://finoptima.services.ai.azure.com/anthropic/"
AZURE_FOUNDRY_BASE_URL=""

# Foundry API anahtarı. VARSA anahtarlı mod kullanılır (en hızlı kurulum).
# BOŞSA aşağıdaki Entra ID (anahtarsız) akışına düşer.
AZURE_FOUNDRY_API_KEY=""

# Entra ID (anahtarsız) — AZURE_FOUNDRY_API_KEY boşken kullanılır.
# a) Azure üzerinde çalışıyorsa Managed Identity otomatik bulunur
#    (IDENTITY_ENDPOINT + IDENTITY_HEADER platform tarafından enjekte edilir) —
#    aşağıdakileri doldurmaya gerek yok.
# b) Azure dışında (Vercel vb.) uygulama kaydı ile client credentials:
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Token scope'u — varsayılan "https://ai.azure.com/.default". Normalde boş bırak.
AZURE_FOUNDRY_SCOPE=""

# Foundry'de model adı bir deployment adıysa eşleme (virgülle ayrık from=to).
# Boşsa model kimlikleri aynen kullanılır.
# Örn: "claude-opus-4-8=opus-prod,claude-sonnet-4-6=sonnet-prod"
AZURE_FOUNDRY_MODEL_MAP=""

# Resend — destek e-posta bildirimleri (talep açıldı / yanıt geldi / çözüldü / izin istendi).
# resend.com'dan alınır. BOŞSA e-posta sessizce atlanır; uygulama normal çalışır.
RESEND_API_KEY=""

# Gönderen adresi — alan adı Resend'de doğrulanmış olmalı.
SUPPORT_EMAIL_FROM="FinOptima Destek <destek@finoptima.dev>"

# E-postalardaki talep linklerinin kök adresi (sondaki / olmadan).
APP_URL="https://www.finoptima.dev"

# Gelen e-posta webhook'u (Resend "Enable Receiving" + svix imzalı).
# BOŞSA /api/webhooks/resend-inbound 503 döner (güvenli kapalı/DORMANT).
# Resend webhook ayarındaki Signing Secret'ı buraya koy.
RESEND_WEBHOOK_SECRET=""

# Destek yanıtlarının döneceği gelen e-posta adresi (Resend'de alım için doğrulanmış).
# Tanımlıysa giden destek bildirimlerine Reply-To olarak eklenir; müşteri cevabı
# bu adrese gelir → webhook doğru talebe düşürür. Boşsa cevap From adresine gider.
SUPPORT_INBOUND_ADDRESS="destek@finoptima.dev"
